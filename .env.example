# Local Model & Server Configuration
# Auto-generated or customized per machine via scripts/benchmark-and-configure.sh
# (Variables keep the historical LOCAL_GEMMA_ prefix; any llama.cpp GGUF model works.)

# Model Settings
LOCAL_GEMMA_MODEL_NAME=gemma-4-12b-it-qat-q4_0
LOCAL_GEMMA_MODEL_PATH=models/gemma-4-12b-it-qat-q4_0.gguf
# Optional speculative decoding. Model-free n-gram drafting speeds up edits that echo input:
#   LOCAL_GEMMA_SPEC_TYPE=ngram-mod
# or a draft model / MTP head matched to the base model:
#   LOCAL_GEMMA_SPEC_TYPE=draft-mtp
#   LOCAL_GEMMA_DRAFT_MODEL_PATH=models/mtp-Qwen3.8-27B-Q4_0.gguf
LOCAL_GEMMA_DRAFT_MODEL_PATH=
LOCAL_GEMMA_SPEC_TYPE=

# Hardware & Engine Tuning
LOCAL_GEMMA_GPU_LAYERS=99
LOCAL_GEMMA_CTX_SIZE=65536
LOCAL_GEMMA_PARALLEL=1
LOCAL_GEMMA_THREADS=8
LOCAL_GEMMA_FLASH_ATTN=on
LOCAL_GEMMA_BATCH_SIZE=2048
LOCAL_GEMMA_UBATCH_SIZE=512

# Network & Server
LOCAL_GEMMA_HOST=127.0.0.1
LOCAL_GEMMA_PORT=8090

# Inference Headroom
LOCAL_GEMMA_MAX_TOKENS=8192
# Default for the tool's `thinking` argument (reasoning phase before the answer)
LOCAL_GEMMA_THINKING=false
# Reasoning depth when thinking is on (low | medium | high; used by e.g. Qwen3.8)
LOCAL_GEMMA_REASONING_EFFORT=medium

# delegate_task agent (OpenCode driving llama-server; config in agent-worker/opencode.json)
# Time budget per delegation; keep below the MCP client's tool timeout (60 min).
LOCAL_AGENT_MAX_MINUTES=30
# OpenCode binary and the directory for its isolated config, sessions, and run logs
#LOCAL_AGENT_OPENCODE_BIN=opencode
#LOCAL_AGENT_STATE_DIR=~/.local/state/local-gemma-agent
