{
  "servers": {
    "asana": {
      "type": "http",
      "url": "https://mcp.asana.com/v2/mcp"
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "bigquery": {
      "args": [
        "-y",
        "@toolbox-sdk/server@>=0.26.0",
        "--prebuilt",
        "bigquery",
        "--stdio"
      ],
      "command": "npx",
      "env": {
        "BIGQUERY_LOCATION": "",
        "BIGQUERY_PROJECT": "uryde-b0423"
      },
      "type": "stdio"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "dart": {
      "args": [
        "mcp-server"
      ],
      "command": "dart",
      "type": "stdio"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "firebase": {
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "local-gemma": {
      "args": [
        "/Users/ninohandler/Development/llm-coding-workflow/mcp-server/server.js"
      ],
      "command": "node",
      "timeout": 600,
      "type": "stdio"
    },
    "mempalace": {
      "command": "mempalace-mcp",
      "type": "stdio"
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/"
    },
    "openai-developer-docs": {
      "type": "http",
      "url": "https://developers.openai.com/mcp"
    }
  }
}
