{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/global-mcp-registry.schema.json",
  "title": "Global MCP Registry",
  "type": "object",
  "required": ["version", "servers"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clients": {
          "type": "array",
          "items": {"$ref": "#/$defs/client"},
          "uniqueItems": true
        }
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]+$"},
      "additionalProperties": {"$ref": "#/$defs/server"}
    }
  },
  "$defs": {
    "client": {
      "enum": ["antigravity", "claude", "codex", "cursor", "hermes", "opencode", "vscode"]
    },
    "server": {
      "type": "object",
      "required": ["transport"],
      "properties": {
        "transport": {"enum": ["stdio", "http", "sse"]},
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "url": {"type": "string", "minLength": 1},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "auth": {"enum": ["none", "oauth"]},
        "bearer_token_env_var": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "enabled": {"type": "boolean"},
        "clients": {"type": "array", "items": {"$ref": "#/$defs/client"}, "uniqueItems": true},
        "imported_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"transport": {"const": "stdio"}}},
          "then": {"required": ["command"]}
        },
        {
          "if": {"properties": {"transport": {"enum": ["http", "sse"]}}},
          "then": {"required": ["url"]}
        }
      ]
    }
  }
}
